      "outputs": [],
      "source": [
        "# Captioning is done. `model` is not needed again until Step 11.2, so free it to make\n",
        "# room for ColPali's patch embeddings alongside the FAISS text index.\n",
        "free_memory(\"model\")\n"
      ],
      "id": "x_Ehlo09_-LK"
